# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
DATABASE_URL=sqlite:///./ustad.db
LANGUAGETOOL_URL=http://localhost:8010

# Local LLM (free): Ollama server for Tutor/Grader/Author. `ollama pull llama3.1:8b` once.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# No paid API keys: speech runs in the browser (Web Speech API), see docs/architecture.md §8.

# Deploy (Phase 1): public hostname for Caddy's automatic HTTPS, e.g. ustad.example.de
DOMAIN=
# Optional bootstrap login: an argon2 hash (make password stores one in the DB instead). Never the plain password.
PASSWORD_HASH=
